# Telegram: create the bot with @BotFather, add it to the channel as an admin who can post.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL_ID=
# Groq (free tier works): https://console.groq.com
GROQ_API_KEY=
# MongoDB: stores what has been sent, so a restart never double-posts.
MONGODB_URI=
MONGODB_DB=upsc_telegram_bot
# Set to 1 to print posts instead of sending them.
DRY_RUN=0
