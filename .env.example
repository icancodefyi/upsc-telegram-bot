# Telegram: create the bot with @BotFather, add it to the channel as an admin who can post.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL_ID=
# Groq (free tier works): https://console.groq.com
GROQ_API_KEY=
# MongoDB: stores what has been sent, so a restart never double-posts.
MONGODB_URI=
MONGODB_DB=upsc_telegram_bot
# Set to 1 to print posts instead of sending them.
DRY_RUN=0

# Optional: your own Telegram chat id. The bot sends you failure alerts and a daily report there.
ADMIN_CHAT_ID=
# Weekly (Sunday) and monthly (1st) website reports to ADMIN_CHAT_ID. The website's database name; it shares MONGODB_URI.
SITE_DB_NAME=
SITE_REPORT_TIME=08:00
# Where the headless browser (for the PDF reports) is installed. Optional.
PLAYWRIGHT_BROWSERS_PATH=
